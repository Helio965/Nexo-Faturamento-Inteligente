# Copie este arquivo para .env e preencha com valores reais
SECRET_KEY=troque-esta-chave-localmente

# Credenciais do administrador master (criado pelo seed) — obrigatórias, sem fallback
ADMIN_MASTER_NOME=Administrador NEXO
ADMIN_MASTER_EMAIL=admin@example.local
ADMIN_MASTER_SENHA=troque-esta-senha

# Valores mensais dos planos (R$) — usados pelo seed.
# ATENÇÃO: os números abaixo são EXEMPLOS FICTÍCIOS, não são preços oficiais.
# A equipe do projeto deve definir os valores comerciais reais antes de produção.
PLANO_BRONZE_VALOR_MENSAL=99.90
PLANO_PRATA_VALOR_MENSAL=199.90
PLANO_OURO_VALOR_MENSAL=349.90
